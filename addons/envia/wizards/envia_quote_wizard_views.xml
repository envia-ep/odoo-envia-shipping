<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_envia_quote_wizard_form" model="ir.ui.view">
        <field name="name">envia.quote.wizard.form</field>
        <field name="model">envia.quote.wizard</field>
        <field name="arch" type="xml">
            <form string="Ship with Envia" class="o_envia_quote_wizard o_envia_quote_wizard_page">
                <header>
                    <button name="action_get_quote" type="object"
                            string="Get Rates" class="btn-primary"
                            invisible="step != 'address' or not can_get_rates"
                            icon="fa-search"/>
                    <button name="action_confirm_selection" type="object"
                            string="Generate Label" class="btn-primary"
                            invisible="step != 'rates' or not selected_service_label"
                            icon="fa-print"/>
                    <button name="action_back_to_address" type="object"
                            string="Back" class="btn-secondary"
                            invisible="step != 'rates'"
                            icon="fa-arrow-left"/>
                    <button name="action_discard" type="object"
                            string="Discard" class="btn-secondary"
                            icon="fa-times"/>
                </header>
                <sheet>
                    <field name="can_get_rates" invisible="1"/>
                    <field name="is_sandbox" invisible="1"/>
                    <field name="is_standalone" invisible="1"/>
                    <field name="origin_contact_complete" invisible="1"/>
                    <field name="destination_contact_complete" invisible="1"/>

                    <div class="oe_title mb-3" invisible="step != 'address'">
                        <h1>1. Shipment details</h1>
                        <field name="route_summary" readonly="1" class="text-muted"
                               invisible="not route_summary"/>
                    </div>

                    <div class="oe_title mb-3" invisible="step != 'rates'">
                        <h1>2. Choose a rate</h1>
                        <field name="route_summary" readonly="1" class="text-muted"
                               invisible="not route_summary"/>
                    </div>

                    <div class="alert alert-info py-2 mb-3" role="status"
                         invisible="step != 'address' or not is_sandbox">
                        Sandbox works best with domestic MX routes.
                        <button name="action_fill_sandbox_test_route" type="object"
                                string="Use test route" class="btn btn-sm btn-link p-0 ms-1"/>
                    </div>

                    <div class="alert alert-danger py-2 mb-3" role="alert"
                         invisible="step != 'address' or can_get_rates or not validation_summary or (is_standalone and destination_location_type == 'address' and not destination_partner_id)">
                        <field name="validation_summary" nolabel="1" readonly="1"/>
                    </div>

                    <div class="row g-3 mb-3" invisible="step != 'address'">
                        <div class="col-lg-6">
                            <div class="o_envia_address_card o_envia_address_card_origin border rounded p-3 h-100 bg-white">
                                <h6 class="text-muted fw-bold mb-2">Ship from</h6>
                                <field name="origin_location_type" widget="radio"/>
                                <field name="origin_partner_id"
                                       invisible="origin_location_type != 'address'"/>
                                <div class="o_envia_address_preview my-2"
                                     invisible="origin_location_type != 'address' or not origin_partner_id">
                                    <field name="origin_address_preview" readonly="1" nolabel="1"/>
                                </div>
                                <group invisible="origin_location_type != 'address'">
                                    <label for="origin_postal_code"/>
                                    <div class="o_row">
                                        <field name="origin_postal_code" class="oe_inline"/>
                                        <button name="action_lookup_origin_zipcode" type="object"
                                                string="Lookup ZIP" class="btn btn-sm btn-link"/>
                                    </div>
                                    <field name="origin_city"/>
                                    <field name="origin_country_id" options="{'no_open': True}"/>
                                    <field name="origin_state_id"
                                           options="{'no_open': True, 'no_create': True}"/>
                                </group>
                                <div invisible="origin_location_type != 'branch'"
                                     class="o_envia_branch_search o_envia_branch_search_origin mt-2">
                                    <p class="o_envia_branch_search_hint mb-0">
                                        <i class="fa fa-info-circle" title="Help"/>
                                        Search drop-off points near the ZIP code.
                                    </p>
                                    <div class="o_envia_branch_search_fields">
                                        <div class="o_envia_branch_search_field">
                                            <label for="origin_branch_carrier_id" class="o_envia_field_label">Carrier</label>
                                            <field name="origin_branch_carrier_id"
                                                   options="{'no_create': True, 'no_open': True}"/>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-sm-6 o_envia_branch_search_field">
                                                <label for="origin_postal_code" class="o_envia_field_label">Near ZIP</label>
                                                <field name="origin_postal_code" nolabel="1"
                                                       placeholder="e.g. 64000"/>
                                            </div>
                                            <div class="col-sm-6 o_envia_branch_search_field">
                                                <label for="origin_country_id" class="o_envia_field_label">Country</label>
                                                <field name="origin_country_id" nolabel="1"
                                                       options="{'no_open': True}"/>
                                            </div>
                                        </div>
                                        <field name="origin_city" invisible="1"/>
                                        <field name="origin_state_id" invisible="1"/>
                                        <div class="o_envia_branch_search_actions">
                                            <button name="action_lookup_origin_zipcode" type="object"
                                                    string="Lookup ZIP" class="btn btn-link btn-sm"
                                                    icon="fa-map-marker"/>
                                            <button name="action_load_origin_branches" type="object"
                                                    string="Search branches" class="btn btn-primary"
                                                    icon="fa-search"/>
                                        </div>
                                    </div>
                                    <div class="o_envia_branch_selected"
                                         invisible="not origin_selected_branch_label">
                                        <i class="fa fa-check-circle" title="Selected branch"/>
                                        <div class="o_envia_branch_selected_text">
                                            <span class="o_envia_branch_selected_title">Selected branch</span>
                                            <field name="origin_selected_branch_label" readonly="1" nolabel="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="o_envia_address_card o_envia_address_card_destination border rounded p-3 h-100 bg-white">
                                <h6 class="text-muted fw-bold mb-2">Ship to</h6>
                                <field name="destination_location_type" widget="radio"/>
                                <p class="text-muted small mb-2"
                                   invisible="destination_partner_id or destination_location_type != 'address' or not is_standalone">
                                    Select or create a contact for the delivery address.
                                </p>
                                <field name="destination_partner_id"
                                       invisible="destination_location_type != 'address'"/>
                                <div class="o_envia_address_preview my-2"
                                     invisible="destination_location_type != 'address' or not destination_partner_id">
                                    <field name="destination_address_preview" readonly="1" nolabel="1"/>
                                </div>
                                <group invisible="destination_location_type != 'address'">
                                    <label for="destination_postal_code"/>
                                    <div class="o_row">
                                        <field name="destination_postal_code" class="oe_inline"/>
                                        <button name="action_lookup_destination_zipcode" type="object"
                                                string="Lookup ZIP" class="btn btn-sm btn-link"/>
                                    </div>
                                    <field name="destination_city"/>
                                    <field name="destination_country_id" options="{'no_open': True}"/>
                                    <field name="destination_state_id"
                                           options="{'no_open': True, 'no_create': True}"/>
                                </group>
                                <div invisible="destination_location_type != 'branch'"
                                     class="o_envia_branch_search o_envia_branch_search_destination mt-2">
                                    <p class="o_envia_branch_search_hint mb-0">
                                        <i class="fa fa-info-circle" title="Help"/>
                                        Search pickup points near the ZIP code.
                                    </p>
                                    <div class="o_envia_branch_search_fields">
                                        <div class="o_envia_branch_search_field">
                                            <label for="destination_branch_carrier_id" class="o_envia_field_label">Carrier</label>
                                            <field name="destination_branch_carrier_id"
                                                   options="{'no_create': True, 'no_open': True}"/>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-sm-6 o_envia_branch_search_field">
                                                <label for="destination_postal_code" class="o_envia_field_label">Near ZIP</label>
                                                <field name="destination_postal_code" nolabel="1"
                                                       placeholder="e.g. 66220"/>
                                            </div>
                                            <div class="col-sm-6 o_envia_branch_search_field">
                                                <label for="destination_country_id" class="o_envia_field_label">Country</label>
                                                <field name="destination_country_id" nolabel="1"
                                                       options="{'no_open': True}"/>
                                            </div>
                                        </div>
                                        <field name="destination_city" invisible="1"/>
                                        <field name="destination_state_id" invisible="1"/>
                                        <div class="o_envia_branch_search_actions">
                                            <button name="action_lookup_destination_zipcode" type="object"
                                                    string="Lookup ZIP" class="btn btn-link btn-sm"
                                                    icon="fa-map-marker"/>
                                            <button name="action_load_destination_branches" type="object"
                                                    string="Search branches" class="btn o_envia_btn_destination"
                                                    icon="fa-search"/>
                                        </div>
                                    </div>
                                    <div class="o_envia_branch_selected"
                                         invisible="not destination_selected_branch_label">
                                        <i class="fa fa-check-circle" title="Selected branch"/>
                                        <div class="o_envia_branch_selected_text">
                                            <span class="o_envia_branch_selected_title">Selected branch</span>
                                            <field name="destination_selected_branch_label" readonly="1" nolabel="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <field name="origin_branch_count" invisible="1"/>
                    <field name="destination_branch_count" invisible="1"/>
                    <field name="origin_selected_branch_label" invisible="1"/>
                    <field name="destination_selected_branch_label" invisible="1"/>

                    <div class="row g-3 mb-3 o_envia_branch_results"
                         invisible="step != 'address' or (origin_location_type != 'branch' and destination_location_type != 'branch')">
                        <div class="col-lg-6" invisible="origin_location_type != 'branch'">
                            <div class="o_envia_branch_panel o_envia_branch_panel_origin h-100">
                                <div class="o_envia_branch_panel_header">
                                    <h6 class="o_envia_branch_panel_title mb-0">
                                        <i class="fa fa-map-marker" title="Origin"/>
                                        Origin branches
                                    </h6>
                                    <span class="badge rounded-pill text-bg-secondary"
                                          invisible="not origin_branch_count">
                                        <field name="origin_branch_count" readonly="1" nolabel="1" class="oe_inline"/>
                                        found
                                    </span>
                                </div>
                                <div class="o_envia_branch_empty" invisible="origin_branch_count">
                                    <i class="fa fa-building-o" title="No branches"/>
                                    <p class="mb-0">Search branches from the form above.</p>
                                </div>
                                <field name="origin_branch_line_ids" nolabel="1"
                                       class="o_envia_branch_list"
                                       mode="list"
                                       invisible="not origin_branch_count"
                                       context="{'default_side': 'origin'}">
                                    <list create="false" delete="false" edit="false"
                                          default_order="distance asc"
                                          decoration-success="is_selected">
                                        <field name="side" column_invisible="True"/>
                                        <field name="name" string="Name"/>
                                        <field name="street" string="Street"/>
                                        <field name="city" string="City"/>
                                        <field name="zip" string="Postal Code"/>
                                        <field name="distance" string="Distance (km)"/>
                                        <field name="is_selected" column_invisible="True"/>
                                        <button name="action_select_branch" type="object"
                                                string="Select" class="btn-primary btn-sm"
                                                invisible="is_selected"/>
                                    </list>
                                </field>
                            </div>
                        </div>
                        <div class="col-lg-6" invisible="destination_location_type != 'branch'">
                            <div class="o_envia_branch_panel o_envia_branch_panel_destination h-100">
                                <div class="o_envia_branch_panel_header">
                                    <h6 class="o_envia_branch_panel_title mb-0">
                                        <i class="fa fa-flag-checkered" title="Destination"/>
                                        Destination branches
                                    </h6>
                                    <span class="badge rounded-pill text-bg-secondary"
                                          invisible="not destination_branch_count">
                                        <field name="destination_branch_count" readonly="1" nolabel="1" class="oe_inline"/>
                                        found
                                    </span>
                                </div>
                                <div class="o_envia_branch_empty" invisible="destination_branch_count">
                                    <i class="fa fa-building-o" title="No branches"/>
                                    <p class="mb-0">Search branches from the form above.</p>
                                </div>
                                <field name="destination_branch_line_ids" nolabel="1"
                                       class="o_envia_branch_list"
                                       mode="list"
                                       invisible="not destination_branch_count"
                                       context="{'default_side': 'destination'}">
                                    <list create="false" delete="false" edit="false"
                                          default_order="distance asc"
                                          decoration-success="is_selected">
                                        <field name="side" column_invisible="True"/>
                                        <field name="name" string="Name"/>
                                        <field name="street" string="Street"/>
                                        <field name="city" string="City"/>
                                        <field name="zip" string="Postal Code"/>
                                        <field name="distance" string="Distance (km)"/>
                                        <field name="is_selected" column_invisible="True"/>
                                        <button name="action_select_branch" type="object"
                                                string="Select" class="btn-primary btn-sm"
                                                invisible="is_selected"/>
                                    </list>
                                </field>
                            </div>
                        </div>
                    </div>

                    <group string="Package" invisible="step != 'address'" col="2">
                        <group>
                            <label for="weight"/>
                            <div class="o_row">
                                <field name="weight" class="oe_inline"/>
                                <span class="text-muted ms-1">kg</span>
                            </div>
                            <field name="content" placeholder="What are you shipping?"/>
                            <field name="declared_value"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Dimensions (cm)">
                            <label for="length"/>
                            <div class="o_row">
                                <field name="length" class="oe_inline"/>
                                <span class="text-muted mx-1">×</span>
                                <field name="width" class="oe_inline"/>
                                <span class="text-muted mx-1">×</span>
                                <field name="height" class="oe_inline"/>
                            </div>
                        </group>
                    </group>

                    <div class="alert alert-success py-2 mb-3" role="status"
                         invisible="step != 'rates' or not selected_service_label">
                        <strong>Selected:</strong>
                        <field name="selected_service_label" nolabel="1" readonly="1" class="ms-1"/>
                    </div>

                    <field name="service_line_ids" nolabel="1"
                           invisible="step != 'rates' or not service_line_ids">
                        <list create="false" delete="false" edit="false"
                              decoration-success="is_selected">
                            <field name="carrier_name" string="Carrier"/>
                            <field name="service_name" string="Service"/>
                            <field name="price" string="Price"/>
                            <field name="currency_name" string="Currency"/>
                            <field name="estimated_delivery_days" string="Days"/>
                            <field name="is_selected" column_invisible="True"/>
                            <button name="action_choose_service" type="object"
                                    string="Select" class="btn-primary"
                                    invisible="is_selected"/>
                        </list>
                    </field>

                    <div class="alert alert-warning py-2 mb-0" role="alert"
                         invisible="step != 'rates' or service_line_ids">
                        No rates returned. Check addresses and try a domestic MX route in sandbox.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
