<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_envia" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.envia</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Envia.com" name="envia">
                    <field name="envia_has_api_token" invisible="1"/>
                    <field name="envia_oauth_connected" invisible="1"/>

                    <block title="Connection"
                           help="Link your Odoo store with Envia.com and manage integration credentials.">
                        <setting string="Envia.com"
                                 help="Connect your store with Envia.com. Only administrators can refresh the integration token.">
                            <div class="o_envia_settings_connection_card">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <div invisible="not envia_oauth_connected"
                                             class="badge rounded-pill text-bg-success o_envia_connection_badge">
                                            <field name="envia_oauth_status_connected"
                                                   nolabel="1"
                                                   readonly="1"/>
                                        </div>
                                        <div invisible="envia_oauth_connected"
                                             class="badge rounded-pill text-bg-secondary o_envia_connection_badge">
                                            <field name="envia_oauth_status_disconnected"
                                                   nolabel="1"
                                                   readonly="1"/>
                                        </div>
                                    </div>
                                    <button name="action_envia_refresh_integration_token" type="object"
                                            string="Refresh token"
                                            class="btn btn-secondary btn-sm"
                                            icon="fa-refresh"
                                            groups="base.group_system"/>
                                </div>
                                <div class="o_envia_settings_version_row d-flex flex-wrap gap-2 mt-2">
                                    <span class="o_envia_settings_version_chip">
                                        <span class="o_envia_settings_version_label">Module</span>
                                        <field name="envia_module_version_display"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </span>
                                    <span class="o_envia_settings_version_chip"
                                          invisible="not envia_oauth_connected">
                                        <span class="o_envia_settings_version_label">Plugin</span>
                                        <field name="envia_plugin_version_display"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Odoo API key"
                                 help="API key Envia.com uses to call back into Odoo. Generate it here and copy it into your Envia.com integration setup."
                                 groups="base.group_system">
                            <field name="envia_integration_api_key"
                                   widget="envia_api_key"
                                   nolabel="1"
                                   readonly="1"/>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                <button name="action_generate_envia_integration_api_key" type="object"
                                        string="Generate API key"
                                        class="btn btn-secondary btn-sm"
                                        invisible="envia_integration_api_key"
                                        icon="fa-key"/>
                                <span class="text-muted small" invisible="envia_integration_api_key">
                                    Generate a key to configure the Envia.com callback.
                                </span>
                            </div>
                        </setting>
                        <setting string="Envia shipping token"
                                 help="Bearer token for api.envia.com (quoting, labels, tracking). Saved automatically by Envia.com during integration."
                                 groups="base.group_system">
                            <field name="envia_api_token_display"
                                   widget="envia_api_key"
                                   nolabel="1"
                                   readonly="1"/>
                            <div class="text-muted small mt-2"
                                 invisible="envia_has_api_token">
                                No token stored yet. Complete the Envia.com connection or wait for the integration callback.
                            </div>
                            <div class="mt-2" invisible="not envia_has_api_token">
                                <button name="action_test_envia_connection" type="object"
                                        string="Test connection"
                                        class="btn btn-secondary btn-sm"
                                        icon="fa-plug"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Shipping defaults"
                           help="Default origin and carriers used when quoting from sales orders and Add shipping.">
                        <setting string="Default ship-from address"
                                 help="Origin for Envia quotes. Must include street, city, postal code, country, phone and email. Destination comes from the customer delivery address on the order.">
                            <field name="envia_default_origin_partner_id"
                                   options="{'no_create': True}"
                                   domain="[('type', 'in', ['contact', 'other', 'invoice'])]"/>
                        </setting>
                        <setting string="Default carriers"
                                 help="Carriers requested when quoting all Envia rates.">
                            <field name="envia_default_carrier_ids" widget="many2many_tags"/>
                        </setting>
                        <setting>
                            <field name="envia_default_carrier"/>
                        </setting>
                        <setting>
                            <field name="envia_enable_branches"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_envia_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'envia'}</field>
    </record>
</odoo>
