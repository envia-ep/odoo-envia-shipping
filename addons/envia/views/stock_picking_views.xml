<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_envia" model="ir.ui.view">
        <field name="name">stock.picking.form.envia</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="envia_status" invisible="1"/>
                <div class="alert alert-success mb-0 rounded-0" role="alert"
                     invisible="envia_status != 'shipped'">
                    <field name="envia_summary" nolabel="1" readonly="1"/>
                </div>
                <div class="alert alert-info mb-0 rounded-0" role="alert"
                     invisible="envia_status != 'quoted'">
                    <field name="envia_summary" nolabel="1" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_envia_quotes" class="oe_stat_button"
                        icon="fa-calculator" invisible="envia_quote_count == 0">
                    <field name="envia_quote_count" widget="statinfo" string="Envia Quotes"/>
                </button>
                <button type="object" name="action_view_envia_shipments" class="oe_stat_button"
                        icon="fa-truck" invisible="envia_shipment_count == 0">
                    <field name="envia_shipment_count" widget="statinfo" string="Envia Shipments"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_envia_quote_wizard" type="object"
                        string="Quote Shipment" class="btn-primary"
                        invisible="state != 'assigned'"/>
                <button name="action_create_envia_shipment" type="object"
                        string="Generate Label"
                        invisible="state != 'assigned' or not envia_can_create_shipment"
                        icon="fa-print"/>
                <field name="envia_can_create_shipment" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
