<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ecart" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ecart</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="ECart" name="ecart_connector">
                    <field name="ecart_has_app_credentials" invisible="1"/>
                    <block title="ECart API"
                           help="Connect e-commerce stores through ECart API and import paid orders into Odoo.">
                        <setting string="App credentials">
                            <field name="ecart_app_id"/>
                            <field name="ecart_client_id"/>
                            <field name="ecart_base_url"/>
                            <field name="ecart_oauth_base_url"/>
                        </setting>
                        <setting string="Order import"
                                 help="Auto-confirm creates stock pickings so Envia can quote and ship imported orders.">
                            <field name="ecart_auto_confirm_orders"/>
                            <field name="ecart_fallback_product_id"/>
                        </setting>
                        <setting string="OAuth URLs">
                            <field name="ecart_oauth_redirect_url" readonly="1"/>
                            <field name="ecart_oauth_connect_url" readonly="1"/>
                        </setting>
                        <setting>
                            <button name="action_open_ecart_oauth" type="object"
                                    string="Connect Store"
                                    class="btn btn-primary"
                                    icon="fa-plug"
                                    invisible="not ecart_has_app_credentials"/>
                            <button name="action_open_ecart_stores" type="object"
                                    string="View Connected Stores"
                                    class="btn btn-secondary"
                                    icon="fa-shopping-bag"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
