<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ecart" model="ir.ui.view">
        <field name="name">sale.order.form.ecart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="ecart_store_id" readonly="1"
                       invisible="not ecart_store_id"/>
                <field name="ecart_order_number" readonly="1"
                       invisible="not ecart_store_id"/>
                <field name="ecart_status" readonly="1"
                       invisible="not ecart_store_id"/>
                <field name="ecart_imported_at" readonly="1"
                       invisible="not ecart_store_id"/>
            </xpath>
        </field>
    </record>
</odoo>
