<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_envia" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.envia</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Envia" name="envia_ecart_integration">
                    <block title="ECart API Configuration">
                        <setting
                            string="OAuth App ID"
                            help="Your ECart API application ID from the Envia dashboard."
                        >
                            <field name="envia_ecart_app_id"/>
                        </setting>
                        <setting
                            string="Client ID"
                            help="Used to validate the OAuth callback signature (ecartapi_key)."
                        >
                            <field name="envia_ecart_client_id" password="True"/>
                        </setting>
                        <setting
                            string="OAuth Base URL"
                            help="Use https://oauth-deve.herokuapp.com for development or https://oauth.ecartapi.com for production."
                        >
                            <field name="envia_ecart_oauth_base_url"/>
                        </setting>
                        <setting
                            string="Store URL Override"
                            help="Public URL of this Odoo instance (e.g. your Cloudflare tunnel). Leave empty to use web.base.url."
                        >
                            <field name="envia_ecart_store_url" placeholder="https://your-odoo.example.com"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
