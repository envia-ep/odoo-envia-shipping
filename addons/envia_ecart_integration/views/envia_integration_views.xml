<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_envia_integration_form" model="ir.ui.view">
        <field name="name">envia.integration.form</field>
        <field name="model">envia.integration</field>
        <field name="arch" type="xml">
            <form string="Envia Integration">
                <header>
                    <button
                        name="action_connect_envia"
                        type="object"
                        string="Connect with Envia"
                        class="btn-primary"
                        invisible="state == 'connected'"
                    />
                    <button
                        name="action_regenerate_api_key"
                        type="object"
                        string="Regenerate API Key"
                        groups="base.group_system"
                        invisible="state == 'connected'"
                    />
                    <button
                        name="action_reset_integration"
                        type="object"
                        string="Reset Integration"
                        confirm="This will disconnect Envia and clear stored tokens."
                        invisible="state != 'connected'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Envia / ECart Integration</h1>
                    </div>
                    <group>
                        <group string="Odoo Connection">
                            <field name="company_id" readonly="state == 'connected'"/>
                            <field name="user_id" readonly="state == 'connected'"/>
                            <field name="store_url" placeholder="Uses web.base.url if empty"/>
                            <field name="integration_date"/>
                        </group>
                        <group string="ECart Store">
                            <field name="ecart_ecommerce"/>
                            <field name="ecart_store_name"/>
                            <field name="ecart_store_url"/>
                            <field name="ecart_user_id"/>
                        </group>
                    </group>
                    <group string="Technical" groups="base.group_system">
                        <field name="odoo_api_key" password="True"/>
                        <field name="access_token" password="True"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_envia_integration_list" model="ir.ui.view">
        <field name="name">envia.integration.list</field>
        <field name="model">envia.integration</field>
        <field name="arch" type="xml">
            <list string="Envia Integrations">
                <field name="company_id"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'connected'"
                    decoration-muted="state == 'draft'"
                    decoration-danger="state == 'error'"/>
                <field name="integration_date"/>
            </list>
        </field>
    </record>

    <record id="action_envia_integration" model="ir.actions.act_window">
        <field name="name">Envia Integration</field>
        <field name="res_model">envia.integration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect your Odoo store with Envia
            </p>
            <p>
                Click <strong>New</strong>, then use <strong>Connect with Envia</strong>
                to open the ECart OAuth form with your store URL, database, email,
                and a persistent API key generated automatically.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_envia_integration_root"
        name="Envia"
        sequence="90"
    />
    <menuitem
        id="menu_envia_integration"
        name="Integration"
        parent="menu_envia_integration_root"
        action="action_envia_integration"
        sequence="10"
    />
</odoo>
