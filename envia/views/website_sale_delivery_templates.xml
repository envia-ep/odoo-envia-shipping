<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="envia_delivery_method" inherit_id="website_sale.delivery_method">
        <xpath expr="//div[hasclass('d-flex') and hasclass('justify-content-between')]" position="after">
            <t t-set="envia_company" t-value="website.company_id"/>
            <div
                t-if="dm.delivery_type == 'envia'"
                t-attf-class="o_envia_delivery_panel mt-3 {{'' if is_selected else 'd-none'}}"
                t-att-data-dm-id="dm.id"
                t-att-data-pickup-enabled="'1' if envia_company.envia_checkout_enable_pickup else '0'"
                t-att-data-show-map="'1' if envia_company.envia_checkout_show_map or envia_company.envia_checkout_pickup_map_only else '0'"
                t-att-data-pickup-map-only="'1' if envia_company.envia_checkout_pickup_map_only else '0'"
            >
                <div
                    t-if="envia_company.envia_checkout_enable_pickup"
                    class="o_envia_route_toggle w-100 mb-3"
                    role="group"
                    aria-label="Delivery route"
                >
                    <button type="button" class="o_envia_route_btn active" data-route-type="ship">
                        <i class="fa fa-truck me-1" aria-hidden="true"/>
                        <t t-if="envia_company.envia_checkout_ship_label" t-esc="envia_company.envia_checkout_ship_label"/>
                        <t t-else="">Ship</t>
                    </button>
                    <button type="button" class="o_envia_route_btn" data-route-type="pickup">
                        <i class="fa fa-map-marker me-1" aria-hidden="true"/>
                        <t t-if="envia_company.envia_checkout_pickup_label" t-esc="envia_company.envia_checkout_pickup_label"/>
                        <t t-else="">Pickup</t>
                    </button>
                </div>
                <div class="o_envia_options_feedback text-muted small mb-2 d-none"/>
                <ul class="list-group o_envia_options_list mb-3"/>
                <div class="o_envia_map d-none border rounded" style="min-height: 280px; height: 280px;"/>
                <t t-set="envia_cart" t-value="website_sale_order or order"/>
                <t t-set="envia_origin_cc"
                   t-value="(envia_cart.warehouse_id.partner_id.country_id.code if envia_cart and envia_cart.warehouse_id and envia_cart.warehouse_id.partner_id.country_id else (website.company_id.country_id.code or '')) or ''"/>
                <t t-set="envia_dest_cc"
                   t-value="(envia_cart.partner_shipping_id.country_id.code if envia_cart and envia_cart.partner_shipping_id and envia_cart.partner_shipping_id.country_id else '') or ''"/>
                <t t-set="envia_is_intl"
                   t-value="envia_origin_cc and envia_dest_cc and envia_origin_cc.upper() != envia_dest_cc.upper()"/>
                <div t-if="envia_is_intl" class="o_envia_tax_id_wrap mt-3">
                    <label class="form-label small" for="o_envia_destination_tax_id">
                        Destination tax ID (optional at checkout)
                    </label>
                    <input type="text"
                           class="form-control form-control-sm o_envia_destination_tax_id"
                           id="o_envia_destination_tax_id"
                           name="o_envia_destination_tax_id"
                           t-att-value="envia_cart.envia_destination_identification_number if envia_cart else ''"
                           placeholder="Tax ID / VAT of the recipient"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
