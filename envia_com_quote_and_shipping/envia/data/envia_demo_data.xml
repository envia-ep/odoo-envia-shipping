<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Origin: complete My Company for domestic MX sandbox quoting (67192 NLE -> 03100 CMX). -->
    <record id="base.main_partner" model="res.partner">
        <field name="street">Aurora Boreal 301</field>
        <field name="city">Guadalupe</field>
        <field name="zip">67192</field>
        <field name="country_id" ref="base.mx"/>
        <field name="state_id" ref="base.state_mx_nl"/>
        <field name="phone">8121211454</field>
        <field name="email">malcom.prado@envia.com</field>
    </record>

    <record id="base.main_company" model="res.company">
        <field name="country_id" ref="base.mx"/>
        <field name="envia_default_origin_warehouse_id" ref="stock.warehouse0"/>
