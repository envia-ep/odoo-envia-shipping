        <field name="envia_default_carrier">True</field>
        <field name="envia_default_carriers">dhl,fedex,estafeta</field>
    </record>

    <record id="envia_demo_customer" model="res.partner">
        <field name="name">Envia Demo Customer</field>
        <field name="street">Av. Insurgentes Sur 1234</field>
        <field name="city">Ciudad de Mexico</field>
        <field name="zip">03100</field>
        <field name="country_id" ref="base.mx"/>
        <field name="state_id" ref="base.state_mx_df"/>
        <field name="phone">5551234567</field>
        <field name="email">demo.customer@envia.test</field>
        <field name="type">contact</field>
    </record>
</odoo>
